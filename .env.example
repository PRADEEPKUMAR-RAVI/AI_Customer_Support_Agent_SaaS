# ---------------------------------------------------------------------------
# Phase-0 environment. Copy to `.env` for local dev (docker-compose reads it).
# Dev/CI defaults run entirely on fakes + local services — NO vendor keys needed.
# ---------------------------------------------------------------------------

APP_ENV=dev                      # dev | ci | prod
LOG_LEVEL=INFO

# --- Postgres (the app connects as a NON-owner, non-superuser role so RLS is never bypassed) ---
# Defaults target the docker-compose pgvector container, exposed on host port 5433 so it
# coexists with a local Postgres on 5432. Running your own local Postgres instead? Change 5433
# to your port and ensure pgvector + the cs_app/cs_bypass roles exist (migrations/sql/init_roles.sql).
# App role (RLS-enforced):
DATABASE_URL=postgresql+asyncpg://cs_app:cs_app_pw@localhost:5433/cs_agent
# Owner/migration role (runs Alembic; owns tables; used ONLY by migrations):
DATABASE_OWNER_URL=postgresql+asyncpg://cs_owner:cs_owner_pw@localhost:5433/cs_agent
# Audited RLS-bypass role for M10 ops (own connection, never the request pool):
DATABASE_BYPASS_URL=postgresql+asyncpg://cs_bypass:cs_bypass_pw@localhost:5433/cs_agent

# --- Redis (cache, idempotency, Celery broker, pub/sub) ---
REDIS_URL=redis://localhost:6379/0

# --- Email / SMTP ---
# Dev default = MailPit (docker service "mailhog", localhost:1025): catches ALL mail in a web UI
# (http://localhost:8025) and sends nothing externally. No auth, no TLS — keeps dev keyless.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@cs-agent.local
SMTP_USER=                       # empty in dev (MailPit needs no auth)
SMTP_PASSWORD=
SMTP_STARTTLS=false              # dev MailPit is plaintext; a provider relay uses true (port 587)
#
# To send REAL email, relay through a free transactional provider. Same code path — only these
# vars change. RECOMMENDED for a POC: Brevo (brevo.com) — 300 emails/day free forever, verify a
# single SENDER in the dashboard (no domain/DNS setup needed to start), EU/GDPR-native. Create an
# SMTP key under "SMTP & API → SMTP", then set:
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_FROM=<your verified sender email>
#   SMTP_USER=<your Brevo SMTP login>      # shown on the SMTP settings page (an @…brevo.com login)
#   SMTP_PASSWORD=<your Brevo SMTP key>    # NOT your account password
#   SMTP_STARTTLS=true
# ALTERNATIVE: Resend (resend.com) — 3,000/mo (100/day) free, cleaner DX, but you MUST verify a
# sending DOMAIN (publish SPF/DKIM/DMARC DNS) before it will deliver to real recipients:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=587
#   SMTP_FROM=no-reply@<your-verified-domain>
#   SMTP_USER=resend
#   SMTP_PASSWORD=<your Resend API key>
#   SMTP_STARTTLS=true

# --- Secrets (dev-only placeholders; generate real ones for prod) ---
JWT_SECRET=dev-insecure-change-me-32-bytes-minimum-secret
# 32-byte base64 key for app-layer AES-GCM connector-credential encryption:
CREDENTIAL_MASTER_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Auth token lifetimes ---
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min (in-memory access token)
REFRESH_TOKEN_TTL_SECONDS=1209600   # 14 days (httpOnly SameSite=Strict cookie)

# --- LLM / embeddings provider selection ---
# Providers default to fakes in dev/CI. Flip these to use real cloud/self-hosted adapters.
USE_FAKE_LLM=true
USE_FAKE_EMBEDDINGS=true
LLM_PROVIDER=openai                 # openai (single provider for the POC)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=                     # only needed when USE_FAKE_LLM=false
# Embeddings + rerank default = self-hosted ONNX via fastembed (no key). Default embedder is the
# LIGHT multilingual model (~0.22GB, 384-dim) so it loads fast on CPU; the reranker stays
# multilingual (bge-reranker-base) and is warmed at API startup. EMBED_DIM MUST match the embed
# model's output dim (it drives the kb_chunk.embedding vector column) — changing the model means
# changing EMBED_DIM + reseeding the KB.
EMBEDDINGS_PROVIDER=bge_onnx        # bge_onnx (self-hosted, default) | cohere (optional managed)
EMBED_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
# Reranker: jina-v2 is multilingual (bge-reranker-base fails Spanish → wrong escalations). It is
# CC-BY-NC (non-commercial) — swap to a commercial-safe multilingual reranker before launch.
RERANK_MODEL=jinaai/jina-reranker-v2-base-multilingual
EMBED_DIM=384
# Cross-encoder rerank toggle. true = full semantic/multilingual grounding (default). false = skip
# the reranker (its ~1GB startup warmup + per-turn CPU pass are the dominant retrieval cost) and
# fall back to a cheap lexical-overlap score; the grounding gate still applies, but matching is
# lexical only, not cross-lingual. No key/model change needed to flip.
RERANK_ENABLED=false
COHERE_API_KEY=                     # only if EMBEDDINGS_PROVIDER=cohere

# --- CORS (staff SPA origin) ---
FRONTEND_ORIGIN=http://localhost:5173
