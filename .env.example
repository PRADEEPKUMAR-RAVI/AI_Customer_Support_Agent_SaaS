# ---------------------------------------------------------------------------
# Phase-0 environment. Copy to `.env` for local dev (docker-compose reads it).
# Dev/CI defaults run entirely on fakes + local services — NO vendor keys needed.
# ---------------------------------------------------------------------------

APP_ENV=dev                      # dev | ci | prod
LOG_LEVEL=INFO

# --- Postgres (the app connects as a NON-owner, non-superuser role so RLS is never bypassed) ---
# Defaults target the docker-compose pgvector container, exposed on host port 5433 so it
# coexists with a local Postgres on 5432. Running your own local Postgres instead? Change 5433
# to your port and ensure pgvector + the cs_app/cs_bypass roles exist (migrations/sql/init_roles.sql).
# App role (RLS-enforced):
DATABASE_URL=postgresql+asyncpg://cs_app:cs_app_pw@localhost:5433/cs_agent
# Owner/migration role (runs Alembic; owns tables; used ONLY by migrations):
DATABASE_OWNER_URL=postgresql+asyncpg://cs_owner:cs_owner_pw@localhost:5433/cs_agent
# Audited RLS-bypass role for M10 ops (own connection, never the request pool):
DATABASE_BYPASS_URL=postgresql+asyncpg://cs_bypass:cs_bypass_pw@localhost:5433/cs_agent

# --- Redis (cache, idempotency, Celery broker, pub/sub) ---
REDIS_URL=redis://localhost:6379/6379

# --- SMTP (MailHog in dev — catches all mail, nothing is sent externally) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@cs-agent.local

# --- Secrets (dev-only placeholders; generate real ones for prod) ---
JWT_SECRET=dev-insecure-change-me-32-bytes-minimum-secret
# 32-byte base64 key for app-layer AES-GCM connector-credential encryption:
CREDENTIAL_MASTER_KEY_B64=MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=

# --- Auth token lifetimes ---
ACCESS_TOKEN_TTL_SECONDS=900        # 15 min (in-memory access token)
REFRESH_TOKEN_TTL_SECONDS=1209600   # 14 days (httpOnly SameSite=Strict cookie)

# --- LLM / embeddings provider selection ---
# Providers default to fakes in dev/CI. Flip these to use real cloud/self-hosted adapters.
USE_FAKE_LLM=true
USE_FAKE_EMBEDDINGS=true
LLM_PROVIDER=openai                 # openai (single provider for the POC)
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=                     # only needed when USE_FAKE_LLM=false
# Embeddings + rerank default = self-hosted BGE via ONNX (no key). Set base URL if serving remotely.
EMBEDDINGS_PROVIDER=bge_onnx        # bge_onnx (self-hosted, default) | cohere (optional managed)
EMBED_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
EMBED_DIM=1024
COHERE_API_KEY=                     # only if EMBEDDINGS_PROVIDER=cohere

# --- CORS (staff SPA origin) ---
FRONTEND_ORIGIN=http://localhost:5173
